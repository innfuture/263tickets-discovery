APP_NAME=Laravel
APP_ENV=local
APP_KEY=base64:CN0zfW/q4Yw/zaGQNFKy8VTn0nkEmFebDrf+01Ts+Do=
# Production: override APP_DEBUG=false and LOG_LEVEL=warning.
APP_DEBUG=true
APP_URL=http://localhost:8001

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=discovery
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

WORKOS_CLIENT_ID=your-workos-client-id
WORKOS_API_KEY=your-workos-api-key
WORKOS_REDIRECT_URL="${APP_URL}/authenticate"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Scanner / NFC / Biometrics ───────────────────────────────────────
SCANNING_BIOMETRIC_PROVIDER=
SCANNING_BIOMETRIC_SECRET=
# Cloudflare KV bridge — origin-side push of voided ticket UUIDs into
# the scanner-edge VOIDED_TICKETS namespace. Leave blank for no-op.
SCANNING_EDGE_KV_ACCOUNT_ID=
SCANNING_EDGE_KV_NAMESPACE_ID=
SCANNING_EDGE_KV_API_TOKEN=

# ── Payments ────────────────────────────────────────────────────────
PAYMENTS_DEFAULT_CURRENCY=USD
# Cross-gateway idempotency cache (PaymentManager::charge).
PAYMENTS_IDEMPOTENCY_HEADER=Idempotency-Key
PAYMENTS_IDEMPOTENCY_TTL=86400
PAYMENTS_IDEMPOTENCY_CACHE_STORE=

# ── Automation ──────────────────────────────────────────────────────
AUTOMATION_RATE_LIMIT=300

# ── Storefront edge HMAC ────────────────────────────────────────────
# Shared with the storefront-edge Worker. Blank = signing disabled.
STOREFRONT_SIGNING_SECRET=

# ── Ad management ───────────────────────────────────────────────────
# Off until the deployment has wired SDK + credentials.
ADS_ENABLED=false
